# Copy to .env and fill in. Never commit .env.
# Your moomoo login is NOT stored here: it lives in OpenD's own config on the OpenD machine.

# moomoo OpenD gateway (read-only use)
# For local Windows trial: keep MOOMOO_HOST=127.0.0.1 and log in via the desktop OpenD app.
# For Docker / Oracle 24/7 deployment: stockagent connects to the internal `opend` container. OpenD 10.x does not
# read a login from here: log in once with `docker compose -f deploy/docker-compose.yml attach opend` (see deploy/ORACLE_SETUP.md).
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_SECURITY_FIRM=FUTUMY
MARKETS=["US"]
# OpenD's RSA private key. Docker sets this itself; set it only if OpenD runs on another machine,
# because OpenD serves positions (trade queries) to non-local clients only over encrypted connections.
# MOOMOO_RSA_KEY_PATH=
# OPEND_VERSION=10.12.7208

# AI models: pick ONE block. DEEP_MODEL makes the final decisions, QUICK_MODEL does the analyst work.

# Google Gemini (free tier available)
LLM_PROVIDER=google
DEEP_MODEL=gemini-3.8-flash
QUICK_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=your-gemini-api-key

# Cloudflare Workers AI (free 10,000 Neurons/day via OpenAI-compatible API)
# Both tiers use the 70B model: it is listed with function calling, which the analysts need for their data
# tools. (llama-3.1-8b-instruct-fast is no longer in Cloudflare's model catalog.)
# LLM_PROVIDER=cloudflare
# DEEP_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# QUICK_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token

# OpenAI (paid, from platform.openai.com; ChatGPT Plus does not include API usage)
# LLM_PROVIDER=openai
# DEEP_MODEL=gpt-6-sol
# QUICK_MODEL=gpt-6-luna
# OPENAI_API_KEY=sk-...

# Anthropic Claude (paid, from console.anthropic.com; Claude Pro does not include API usage)
# LLM_PROVIDER=anthropic
# DEEP_MODEL=claude-sonnet-5-5
# QUICK_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# Telegram
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=123456789

# Storage and config
DB_PATH=data/stockagent.db

# Free-tier limits (raise when on a paid model)
MAX_DEBATE_ROUNDS=1
MAX_RISK_DISCUSS_ROUNDS=1
MAX_CANDIDATES=5
MAX_RUNS_PER_DAY=6
# Safety cap on chat AI calls per day (each lookup round counts)
CHAT_MAX_PER_DAY=1000

# moomoo = live push quotes; poll = yfinance polling fallback
PRICE_SOURCE=moomoo
POLL_INTERVAL_S=300
TZ=Asia/Kuala_Lumpur
