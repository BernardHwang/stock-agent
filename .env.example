# Copy to .env and fill in. Never commit .env.
# Your moomoo login is NOT stored here: it lives in OpenD's own config on the OpenD machine.

# moomoo OpenD gateway (read-only use)
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_SECURITY_FIRM=FUTUMY
MARKETS=["US"]

# AI models: pick ONE block. DEEP_MODEL makes the final decisions, QUICK_MODEL does the analyst work.

# Google Gemini (free tier available)
LLM_PROVIDER=google
DEEP_MODEL=gemini-3.8-flash
QUICK_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=your-gemini-api-key

# OpenAI (paid, from platform.openai.com; ChatGPT Plus does not include API usage)
# LLM_PROVIDER=openai
# DEEP_MODEL=gpt-6-sol
# QUICK_MODEL=gpt-6-luna
# OPENAI_API_KEY=sk-...

# Anthropic Claude (paid, from console.anthropic.com; Claude Pro does not include API usage)
# LLM_PROVIDER=anthropic
# DEEP_MODEL=claude-sonnet-5-5
# QUICK_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# Telegram
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=123456789

# Storage and config
DB_PATH=data/stockagent.db

# Free-tier limits (raise when on a paid model)
MAX_DEBATE_ROUNDS=1
MAX_RISK_DISCUSS_ROUNDS=1
MAX_CANDIDATES=5
MAX_RUNS_PER_DAY=6

# moomoo = live push quotes; poll = yfinance polling fallback
PRICE_SOURCE=moomoo
POLL_INTERVAL_S=300
TZ=Asia/Kuala_Lumpur
