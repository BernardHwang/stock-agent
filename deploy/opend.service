# systemd unit for moomoo command-line OpenD on VM A (Ubuntu, x86-64).
# Install: sudo cp opend.service /etc/systemd/system/ && sudo systemctl enable --now opend
# OpenD reads /opt/opend/OpenD.xml. Set there:
#   api_ip    = this VM's PRIVATE IP (never 0.0.0.0 on a public interface)
#   api_port  = 11111
#   telnet_ip = 127.0.0.1   (used for SMS verification, see ORACLE_SETUP.md)
#   login_account / login_pwd_md5 (or as the current OpenD release documents)
[Unit]
Description=moomoo OpenD gateway
After=network-online.target
Wants=network-online.target

[Service]
User=opend
WorkingDirectory=/opt/opend
ExecStart=/opt/opend/OpenD
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
