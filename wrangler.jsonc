{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stock-agent",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Role instructions in skills/*.md are bundled as plain text.
	"rules": [
		{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
	],
	// Request and cron logs in the dashboard (Observability tab); the free plan includes 200k events a day.
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stock-agent",
			"database_id": "d8a5774d-dd80-4364-b6cb-df82d34e0cbe",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"OWNER_TZ": "Asia/Kuala_Lumpur",
		"PRICE_HOURS": "24h",
		// Your Worker address, e.g. https://stock-agent.<you>.workers.dev. Once set, the Worker registers its own
		// Telegram webhook and moomoo client after each deploy.
		"PUBLIC_URL": "https://stock-agent.laohwang0523.workers.dev"
	}
	// Secrets (dashboard or wrangler secret put): TELEGRAM_BOT_TOKEN, OWNER_CHAT_ID.
	// Optional: TELEGRAM_WEBHOOK_SECRET and MOOMOO_CLIENT_ID (otherwise the Worker creates and keeps its own).
}
